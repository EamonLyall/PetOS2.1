# ============ 开发环境变量（本地 npm run dev 使用） ============
# 后端 REST API 前缀（Vite 代理 /api → vite.config.js 中配置的 target）
VITE_API_BASE=/api

# MQTT Broker（ESP32 与前端经消息总线通信）
# 本地/局域网常用：ws://192.168.x.x:8083/mqtt ；EMQX 内置 WebSocket 端口默认 8083
VITE_MQTT_URL=ws://127.0.0.1:8083/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# 大模型 API（OpenAI 兼容协议；密钥只应放在后端代理，前端不直连生产密钥）
VITE_LLM_BASE_URL=/api/llm
VITE_LLM_MODEL=petos-assistant

# 摄像头视频流地址（ESP32-CAM MJPEG 流；留空时使用占位演示图）
# 局域网示例：http://192.168.4.1/stream ；经 Vite 代理则写 /cam/stream
VITE_CAM_STREAM_URL=
