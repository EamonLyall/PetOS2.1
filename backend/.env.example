# ============================================================
# PetOS 后端环境变量模板
# 用法：复制本文件为 .env，按实际环境填写；留空的项表示“未接入外部服务”，
#       后端会自动进入演示/兜底模式，不影响本地联调。
# ============================================================

# ---------- 服务基础配置 ----------
# 后端 HTTP 端口，必须与前端 vite.config.js 中 /api 代理目标一致（8080）
APP_PORT=8080
# 跨域允许的前端来源；本地开发填前端地址，* 表示全部放开（仅演示用）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库配置 ----------
# 默认 SQLite 内嵌库（免安装，文件落在后端目录下 petos.db）
DATABASE_URL=sqlite:///./petos.db
# 【切换 MySQL 时】把上面一行注释掉，改用下面这行，并在 sql/ 目录执行建库脚本：
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/petos_companion?charset=utf8mb4

# ---------- MQTT Broker（ESP32 / 香橙派通信总线）【预留，可留空】 ----------
# 留空表示不连接 Broker，下行指令仅落库/打印日志，演示模式可正常运行。
# 本地 EMQX TCP 端口默认 1883；浏览器 WebSocket 端口 8083（那是前端用的）。
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=petos-backend-server

# ---------- 大模型 API（OpenAI 兼容协议）【预留，可留空】 ----------
# 密钥只放在后端，前端绝不直连第三方。留空时 /api/chat 走内置兜底话术。
# 示例（DeepSeek / 通义 / 豆包火山方舟等，只要兼容 OpenAI 协议即可）：
# LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=petos-assistant

# ---------- 文件存储 ----------
# 抓拍图片保存目录；前端通过 /images/xxx.jpg 访问
UPLOAD_DIR=./upload-images
