# =============================================================
# PetOS 2.1 — Git 忽略规则
# 只提交源代码与文档；构建产物、本地数据库、密钥、依赖均不入库。
# =============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ---------- 前端 / Node 构建产物 ----------
node_modules/
dist/
dist-ssr/
*.local

# ---------- 本地环境变量（保留 *.example / *.development / *.production） ----------
.env
.env.local
.env.*.local

# ---------- 本地 SQLite 数据库 ----------
# 首次启动后端会自动建表并写入种子数据；数据库文件不入库。
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------- 数据库导出快照（db_tool.py export 按需生成，不入库） ----------
backend/sql/

# ---------- 运行时抓拍上传（首次启动自动创建目录） ----------
backend/upload-images/

# ---------- 日志 ----------
*.log
logs/

# ---------- IDE / 操作系统 ----------
.idea/
.vscode/
*.swp
*.swo
.vs/
.DS_Store
Thumbs.db
desktop.ini
